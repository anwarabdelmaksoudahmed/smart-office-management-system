{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm_config_production=false pnpm install",
  "buildCommand": "pnpm --filter @smart-office/shared build && pnpm --filter @smart-office/api exec prisma generate --schema=./prisma/schema.prisma && pnpm --filter @smart-office/api build && pnpm --filter @smart-office/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{apps/api/dist/**,apps/api/prisma/**,node_modules/.pnpm/@prisma+client@*/**/,node_modules/.pnpm/@smart-office+shared@*/**/,packages/shared/dist/**}"
    }
  }
}
