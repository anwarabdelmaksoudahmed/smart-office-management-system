# Copy to apps/api/.env and root .env as needed
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://smart_office:smart_office_dev@localhost:5432/smart_office?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=

THROTTLE_TTL=60
THROTTLE_LIMIT=100
